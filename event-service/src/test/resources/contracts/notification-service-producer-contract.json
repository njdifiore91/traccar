{
  "provider": {
    "name": "event-service"
  },
  "consumer": {
    "name": "notification-service"
  },
  "providerStates": [
    {
      "name": "Event Service is running and connected to the message broker"
    },
    {
      "name": "Event Service has detected events that require notifications"
    },
    {
      "name": "Event Service has access to position data for events"
    }
  ],
  "interactions": [
    {
      "description": "a notification request for an alarm event",
      "request": {
        "method": "POST",
        "path": "/api/notifications",
        "headers": {
          "Content-Type": "application/json",
          "X-Correlation-ID": "${uuid()}"
        },
        "body": {
          "eventId": "${number()}",
          "eventType": "alarm",
          "deviceId": "${number()}",
          "timestamp": "${timestamp()}",
          "attributes": {
            "alarmType": "general"
          },
          "position": {
            "latitude": "${decimal()}",
            "longitude": "${decimal()}",
            "altitude": "${decimal()}",
            "speed": "${decimal()}",
            "course": "${decimal()}",
            "address": "${string()}",
            "attributes": {
              "protocol": "${string()}"
            }
          },
          "metadata": {
            "priority": "high",
            "notificationChannels": ["email", "sms", "push"],
            "correlationId": "${uuid()}",
            "sourceService": "event-service",
            "timestamp": "${timestamp()}"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": true,
          "notificationId": "${string()}"
        }
      }
    },
