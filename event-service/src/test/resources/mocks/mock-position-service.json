            "payload.latitude": 37.7800,
            "payload.longitude": -122.4150,
            "payload.address": "Inside Geofence, San Francisco, CA"
          }
        }
      ]
    },
    "geofenceExit": {
      "description": "Simulates a device exiting a geofence",
      "sequence": [
        {
