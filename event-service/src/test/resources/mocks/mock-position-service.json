  "scenarios": {
    "motionDetection": {
      "description": "Simulates a device transitioning from stopped to moving state",
      "sequence": [
        {
          "messagePattern": "positionUpdateStopped",
          "delay": "0s"
        },
        {
          "messagePattern": "positionUpdateMoving",
          "delay": "30s"
        },
        {
          "messagePattern": "positionUpdateMoving",
          "delay": "30s",
          "overrides": {
            "payload.attributes.distance": 600.0
          }
        }
      ]
    },
    "motionStop": {
      "description": "Simulates a device transitioning from moving to stopped state",
      "sequence": [
        {
          "messagePattern": "positionUpdateMoving",
          "delay": "0s"
        },
        {
          "messagePattern": "positionUpdateStopped",
          "delay": "30s"
        },
        {
          "messagePattern": "positionUpdateStopped",
          "delay": "5m"
        }
      ]
    },
    "overspeedEvent": {
      "description": "Simulates a device exceeding speed limit",
      "sequence": [
        {
          "messagePattern": "positionUpdateMoving",
          "delay": "0s"
        },
        {
          "messagePattern": "positionUpdateOverspeed",
          "delay": "30s"
        },
        {
          "messagePattern": "positionUpdateMoving",
          "delay": "1m"
        }
      ]
    },
    "lowBatteryEvent": {
      "description": "Simulates a device with low battery",
      "sequence": [
        {
          "messagePattern": "positionUpdate",
          "delay": "0s",
          "overrides": {
            "payload.attributes.batteryLevel": 25
          }
        },
        {
          "messagePattern": "positionUpdateLowBattery",
          "delay": "30s"
        },
        {
          "messagePattern": "positionUpdateLowBattery",
          "delay": "30s",
          "overrides": {
            "payload.attributes.batteryLevel": 10
          }
        }
      ]
    },
    "geofenceEntry": {
      "description": "Simulates a device entering a geofence",
      "sequence": [
        {
          "messagePattern": "positionUpdate",
          "delay": "0s",
          "overrides": {
            "payload.latitude": 37.7700,
            "payload.longitude": -122.4200,
            "payload.address": "Outside Geofence, San Francisco, CA"
          }
        },
        {
          "messagePattern": "positionUpdate",
          "delay": "30s",
          "overrides": {
            "payload.latitude": 37.7749,
            "payload.longitude": -122.4194,
            "payload.address": "Geofence Boundary, San Francisco, CA"
          }
