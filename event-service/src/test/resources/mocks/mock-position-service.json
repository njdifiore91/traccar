  "configuration": {
    "responseDelay": {
      "min": "10ms",
      "max": "50ms"
    },
    "errorRate": 0.01,
    "timeVariables": {
      "now": "current_time",
      "today": "current_date"
    },
    "positionEnrichment": {
      "geocoding": true,
      "speedCalculation": true,
      "distanceCalculation": true,
      "motionDetection": true
    }
  }
