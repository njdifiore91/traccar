{
  "description": "RabbitMQ consumer message templates for Position Service testing",
  "version": "1.0",
  "messageSchema": {
    "type": "object",
    "properties": {
      "properties": {
        "type": "object",
        "description": "RabbitMQ message properties",
        "properties": {
          "contentType": {
            "type": "string",
            "description": "Content type of the message payload"
          },
          "contentEncoding": {
            "type": "string",
            "description": "Content encoding of the message payload"
          },
          "headers": {
            "type": "object",
            "description": "Custom headers for the message"
          },
          "deliveryMode": {
            "type": "integer",
            "description": "Delivery mode (1 = non-persistent, 2 = persistent)"
          },
          "priority": {
            "type": "integer",
            "description": "Message priority (0-9)"
          },
          "correlationId": {
            "type": "string",
            "description": "Correlation identifier for request/reply pattern"
          },
          "replyTo": {
            "type": "string",
            "description": "Queue name to reply to"
          },
          "expiration": {
            "type": "string",
            "description": "Message expiration specification"
          },
          "messageId": {
            "type": "string",
            "description": "Message identifier"
          },
          "timestamp": {
            "type": "string",
            "description": "Message timestamp"
          },
          "type": {
            "type": "string",
            "description": "Message type name"
          },
          "userId": {
            "type": "string",
            "description": "User ID"
          },
          "appId": {
            "type": "string",
            "description": "Application ID"
          },
          "clusterId": {
            "type": "string",
            "description": "Cluster ID"
          }
        }
      },
      "routingKey": {
        "type": "string",
        "description": "Routing key used for the message"
      },
      "payload": {
        "type": "object",
        "description": "Message payload containing position data",
        "properties": {
          "deviceId": {
            "type": "integer",
            "description": "Device identifier"
          },
          "protocol": {
            "type": "string",
            "description": "Protocol name"
          },
          "serverTime": {
            "type": "string",
            "description": "Server timestamp when the message was received"
          },
          "deviceTime": {
            "type": "string",
            "description": "Device timestamp when the position was recorded"
          },
          "fixTime": {
            "type": "string",
            "description": "GPS fix timestamp"
          },
          "valid": {
            "type": "boolean",
            "description": "Position validity flag"
          },
          "latitude": {
            "type": "number",
            "description": "Latitude in degrees"
          },
          "longitude": {
            "type": "number",
            "description": "Longitude in degrees"
          },
          "altitude": {
            "type": "number",
            "description": "Altitude in meters"
          },
          "speed": {
            "type": "number",
            "description": "Speed in knots"
          },
          "course": {
            "type": "number",
            "description": "Course in degrees"
          },
          "address": {
            "type": "string",
            "description": "Geocoded address"
          },
          "attributes": {
            "type": "object",
            "description": "Additional attributes specific to the protocol"
          }
        },
        "required": ["deviceId", "protocol", "fixTime", "latitude", "longitude"]
      }
    },
    "required": ["properties", "routingKey", "payload"]
  },
  "routingKeyPatterns": {
    "allPositions": "position.#",
    "rawPositions": "position.raw.#",
    "processedPositions": "position.processed.#",
    "deviceSpecific": "position.device.{deviceId}",
    "protocolSpecific": "position.protocol.{protocol}"
  },
  "templates": [
    {
