{
  "description": "RabbitMQ mock broker configuration for Position Service tests",
  "version": "1.0",
  "connection": {
    "host": "localhost",
    "port": 5672,
    "virtualHost": "/position-service-test",
    "username": "guest",
    "password": "guest",
    "automaticRecovery": true,
    "recoveryInterval": 5000,
    "connectionTimeout": 30000,
    "handshakeTimeout": 10000,
    "shutdownTimeout": 10000,
    "heartbeat": 30,
    "channelMax": 2047,
    "frameMax": 131072,
    "networkRecoveryInterval": 5000,
    "topologyRecovery": true,
    "connectionPoolSize": 5,
    "channelPoolSize": 25,
    "channelCheckoutTimeout": 10000
  },
  "ssl": {
    "enabled": false,
    "verifyHostname": true,
    "algorithm": "TLSv1.2",
    "keyStore": "",
    "keyStorePassword": "",
    "keyStoreType": "PKCS12",
    "trustStore": "",
    "trustStorePassword": "",
    "trustStoreType": "JKS"
  },
  "broker": {
    "mockDelayMs": 0,
    "mockFailureRate": 0.0,
    "mockQueueSize": 10000,
    "mockExchangeSize": 10000,
    "mockBindingSize": 1000,
    "mockConsumerSize": 1000,
    "mockChannelSize": 100,
    "mockConnectionSize": 10
  },
  "exchanges": [
    {
      "name": "position.exchange",
      "type": "topic",
      "durable": true,
      "autoDelete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "event.exchange",
      "type": "topic",
      "durable": true,
      "autoDelete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "command.exchange",
      "type": "direct",
      "durable": true,
      "autoDelete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "position.dlx",
      "type": "fanout",
      "durable": true,
      "autoDelete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "event.dlx",
      "type": "fanout",
      "durable": true,
      "autoDelete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "position.raw",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 86400000,
        "x-dead-letter-exchange": "position.dlx",
        "x-dead-letter-routing-key": "position.raw.dlq"
      }
    },
    {
      "name": "position.enriched",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 86400000,
        "x-dead-letter-exchange": "position.dlx",
        "x-dead-letter-routing-key": "position.enriched.dlq"
      }
    },
    {
      "name": "position.updates",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 60000,
        "x-dead-letter-exchange": "position.dlx",
        "x-dead-letter-routing-key": "position.updates.dlq"
      }
    },
    {
      "name": "position.commands",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 30000,
        "x-dead-letter-exchange": "position.dlx",
        "x-dead-letter-routing-key": "position.commands.dlq"
      }
    },
    {
      "name": "event.geofence",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 86400000,
        "x-dead-letter-exchange": "event.dlx",
        "x-dead-letter-routing-key": "event.geofence.dlq"
      }
    },
    {
      "name": "event.overspeed",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 86400000,
        "x-dead-letter-exchange": "event.dlx",
        "x-dead-letter-routing-key": "event.overspeed.dlq"
      }
    },
    {
      "name": "event.motion",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 86400000,
        "x-dead-letter-exchange": "event.dlx",
        "x-dead-letter-routing-key": "event.motion.dlq"
      }
    },
    {
      "name": "event.device",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 86400000,
        "x-dead-letter-exchange": "event.dlx",
        "x-dead-letter-routing-key": "event.device.dlq"
      }
    },
    {
      "name": "position.raw.dlq",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 604800000,
        "x-queue-mode": "lazy"
      }
    },
    {
      "name": "position.enriched.dlq",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 604800000,
        "x-queue-mode": "lazy"
      }
    },
    {
      "name": "position.updates.dlq",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 604800000,
        "x-queue-mode": "lazy"
      }
    },
    {
      "name": "position.commands.dlq",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 604800000,
        "x-queue-mode": "lazy"
      }
    },
    {
      "name": "event.geofence.dlq",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 604800000,
        "x-queue-mode": "lazy"
      }
    },
    {
      "name": "event.overspeed.dlq",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 604800000,
        "x-queue-mode": "lazy"
      }
    },
    {
      "name": "event.motion.dlq",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 604800000,
        "x-queue-mode": "lazy"
      }
    },
    {
      "name": "event.device.dlq",
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "arguments": {
        "x-message-ttl": 604800000,
        "x-queue-mode": "lazy"
      }
    }
  ],
  "bindings": [
    {
      "source": "position.exchange",
      "destination": "position.raw",
      "destinationType": "queue",
      "routingKey": "position.raw.#"
    },
    {
      "source": "position.exchange",
      "destination": "position.enriched",
      "destinationType": "queue",
      "routingKey": "position.enriched.#"
    },
    {
      "source": "position.exchange",
      "destination": "position.updates",
      "destinationType": "queue",
      "routingKey": "position.updates.#"
    },
    {
      "source": "command.exchange",
      "destination": "position.commands",
      "destinationType": "queue",
      "routingKey": "position.command"
    },
    {
      "source": "event.exchange",
      "destination": "event.geofence",
      "destinationType": "queue",
      "routingKey": "event.geofence.#"
    },
    {
      "source": "event.exchange",
      "destination": "event.overspeed",
      "destinationType": "queue",
      "routingKey": "event.overspeed.#"
    },
    {
      "source": "event.exchange",
      "destination": "event.motion",
      "destinationType": "queue",
      "routingKey": "event.motion.#"
    },
    {
      "source": "event.exchange",
      "destination": "event.device",
      "destinationType": "queue",
      "routingKey": "event.device.#"
    },
    {
      "source": "position.dlx",
      "destination": "position.raw.dlq",
      "destinationType": "queue",
      "routingKey": "position.raw.dlq"
    },
    {
      "source": "position.dlx",
      "destination": "position.enriched.dlq",
      "destinationType": "queue",
      "routingKey": "position.enriched.dlq"
    },
    {
      "source": "position.dlx",
      "destination": "position.updates.dlq",
      "destinationType": "queue",
      "routingKey": "position.updates.dlq"
    },
    {
      "source": "position.dlx",
      "destination": "position.commands.dlq",
      "destinationType": "queue",
      "routingKey": "position.commands.dlq"
    },
    {
      "source": "event.dlx",
      "destination": "event.geofence.dlq",
      "destinationType": "queue",
      "routingKey": "event.geofence.dlq"
    },
    {
      "source": "event.dlx",
      "destination": "event.overspeed.dlq",
      "destinationType": "queue",
      "routingKey": "event.overspeed.dlq"
    },
    {
      "source": "event.dlx",
      "destination": "event.motion.dlq",
      "destinationType": "queue",
      "routingKey": "event.motion.dlq"
    },
    {
      "source": "event.dlx",
      "destination": "event.device.dlq",
      "destinationType": "queue",
      "routingKey": "event.device.dlq"
    }
  ],
  "consumers": {
    "defaultPrefetchCount": 100,
    "defaultAcknowledgeMode": "manual",
    "defaultConcurrentConsumers": 5,
    "defaultMaxConcurrentConsumers": 10,
    "defaultRequeueRejected": true,
    "defaultRecoveryBackOff": {
      "initialInterval": 1000,
      "maxInterval": 30000,
      "multiplier": 2.0,
      "maxAttempts": 10
    }
  },
  "producers": {
    "defaultConfirmType": "correlated",
    "defaultPublisherReturns": true,
    "defaultMandatory": true,
    "defaultDeliveryMode": 2,
    "defaultPriority": 0,
    "defaultContentType": "application/json",
    "defaultContentEncoding": "UTF-8",
    "defaultCorrelationFunction": "uuid",
    "defaultRetryTemplate": {
      "initialInterval": 1000,
      "maxInterval": 10000,
      "multiplier": 1.5,
      "maxAttempts": 3
    }
  },
  "metrics": {
    "enabled": true,
    "publishInterval": 30000,
    "counterTypes": [
      "published",
      "acknowledged",
      "rejected",
      "consumed",
      "failed"
    ],
    "gaugeTypes": [
      "connections",
      "channels",
      "consumers",
      "queueSize"
    ],
    "histogramTypes": [
      "publishLatency",
      "consumeLatency",
      "acknowledgeLatency"
    ]
  },
  "testScenarios": {
    "normal": {
      "mockDelayMs": 0,
      "mockFailureRate": 0.0
    },
    "slowBroker": {
      "mockDelayMs": 500,
      "mockFailureRate": 0.0
    },
    "unreliableBroker": {
      "mockDelayMs": 0,
      "mockFailureRate": 0.1
    },
    "veryUnreliableBroker": {
      "mockDelayMs": 250,
      "mockFailureRate": 0.25
    },
    "brokerOutage": {
      "mockDelayMs": 0,
      "mockFailureRate": 1.0,
      "outageTimeMs": 10000
    },
    "connectionFailure": {
      "connectionRefused": true,
      "reconnectAfterMs": 15000
    },
    "channelFailure": {
      "channelClose": true,
      "closeReason": "Channel closed by server",
      "closeCode": 320,
      "reopenAfterMs": 5000
    },
    "publishConfirmTimeout": {
      "confirmTimeoutMs": 10000,
      "affectedExchanges": ["position.exchange", "event.exchange"]
    }
  },
  "logging": {
    "level": "INFO",
    "includeProperties": true,
    "includeHeaders": true,
    "includeBody": false,
    "maxBodyLogSize": 1024,
    "logToConsole": true,
    "logToFile": false,
    "logFile": "rabbitmq-mock.log"
  },
  "pluginSupport": {
    "enabledPlugins": [
      "rabbitmq_management",
      "rabbitmq_shovel",
      "rabbitmq_federation",
      "rabbitmq_consistent_hash_exchange"
    ],
    "exchangeTypes": [
      "direct",
      "topic",
      "fanout",
      "headers",
      "x-consistent-hash",
      "x-delayed-message"
    ],
    "queueTypes": [
      "classic",
      "quorum",
      "stream"
    ]
  }
}