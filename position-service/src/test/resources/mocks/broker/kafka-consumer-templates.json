{
  "schemaVersion": "1.0",
  "description": "Kafka consumer templates for position messages consumed by the Position Service",
  "positionMessageSchema": {
    "type": "object",
    "required": ["deviceId", "protocol", "timestamp", "latitude", "longitude", "valid"],
    "properties": {
      "deviceId": {
        "type": "integer",
        "description": "Unique identifier of the device"
      },
      "protocol": {
        "type": "string",
        "description": "Protocol used by the device"
      },
      "timestamp": {
        "type": "integer",
        "format": "int64",
        "description": "Unix timestamp in milliseconds"
      },
      "latitude": {
        "type": "number",
        "format": "double",
        "description": "Latitude coordinate in decimal degrees"
      },
      "longitude": {
        "type": "number",
        "format": "double",
        "description": "Longitude coordinate in decimal degrees"
      },
      "altitude": {
        "type": "number",
        "format": "double",
        "description": "Altitude in meters above sea level",
        "nullable": true
      },
      "speed": {
        "type": "number",
        "format": "double",
        "description": "Speed in knots",
        "nullable": true
      },
      "course": {
        "type": "number",
        "format": "double",
        "description": "Course in degrees",
        "nullable": true
      },
      "accuracy": {
        "type": "number",
        "format": "double",
        "description": "Position accuracy in meters",
        "nullable": true
      },
      "valid": {
        "type": "boolean",
        "description": "Indicates if the position is valid"
      },
      "attributes": {
        "type": "object",
        "description": "Protocol-specific attributes",
        "additionalProperties": true
      }
    }
  },
  "kafkaMetadata": {
    "topic": "raw-positions",
    "partitionKey": "deviceId",
    "headers": {
      "messageType": "position",
      "version": "1.0",
      "source": "protocol-service"
    },
    "consumerGroup": "position-service-group"
  },
