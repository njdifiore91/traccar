  "validationRules": {
    "deviceId": {
      "rule": "deviceId > 0",
      "errorMessage": "Device ID must be a positive integer"
    },
    "timestamp": {
      "rule": "timestamp > 0 && timestamp <= System.currentTimeMillis() + 60000",
      "errorMessage": "Timestamp must be valid and not in the future (allowing 1 minute clock drift)"
    },
    "coordinates": {
      "rule": "valid == false || (latitude >= -90 && latitude <= 90 && longitude >= -180 && longitude <= 180)",
      "errorMessage": "Valid positions must have valid latitude and longitude coordinates"
    },
    "speed": {
      "rule": "speed == null || speed >= 0",
      "errorMessage": "Speed must be null or non-negative"
    },
    "course": {
      "rule": "course == null || (course >= 0 && course < 360)",
      "errorMessage": "Course must be null or between 0 and 359.99 degrees"
    }
  },
  "processingInstructions": {
    "invalidPositionHandling": "process",
    "duplicateDetection": true,
    "duplicateWindowSeconds": 60,
    "outOfOrderHandling": "resequence",
    "maxResequenceWindowMinutes": 60,
    "attributeFiltering": false
  }
}