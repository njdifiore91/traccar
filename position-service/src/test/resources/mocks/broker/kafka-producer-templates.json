      "schema": {
        "type": "object",
        "required": ["headers", "payload"],
        "properties": {
          "headers": {
            "type": "object",
            "required": ["messageType", "timestamp", "correlationId"],
            "properties": {
              "messageType": {"type": "string", "enum": ["POSITION"]},
              "timestamp": {"type": "number", "format": "int64"},
              "correlationId": {"type": "string", "format": "uuid"},
              "deviceId": {"type": "number", "format": "int64"}
            }
          },
          "payload": {
            "type": "object",
            "required": ["id", "deviceId", "protocol", "deviceTime", "fixTime", "valid", "latitude", "longitude"],
            "properties": {
              "id": {"type": "number", "format": "int64"},
              "deviceId": {"type": "number", "format": "int64"},
