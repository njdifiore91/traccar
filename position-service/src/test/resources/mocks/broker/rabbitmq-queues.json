  "testConfigurations": {
    "positionServiceConsumer": {
      "queues": ["position.raw"],
      "prefetchCount": 100,
      "acknowledgeMode": "manual",
      "concurrentConsumers": 5,
      "maxConcurrentConsumers": 10
    },
    "positionServiceProducer": {
      "exchanges": ["position.exchange", "event.exchange"],
      "routingKeyPatterns": {
        "enrichedPositions": "position.enriched.{deviceId}",
        "positionUpdates": "position.updates.{deviceId}",
        "geofenceEvents": "event.geofence.{deviceId}",
        "overspeedEvents": "event.overspeed.{deviceId}",
        "motionEvents": "event.motion.{deviceId}",
        "deviceEvents": "event.device.{deviceId}"
      },
      "confirmPublish": true,
      "returnUnroutable": true,
      "mandatory": true
    },
    "virtualHost": "/position-service-test",
    "connectionPoolSize": 5,
    "channelPoolSize": 25,
    "networkRecoveryInterval": 5000,
    "connectionTimeout": 30000,
    "handshakeTimeout": 10000,
    "shutdownTimeout": 10000,
    "heartbeatInterval": 30,
    "automaticRecovery": true,
    "topologyRecovery": true
  }
