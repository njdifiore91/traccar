{
  "scenarios": [
    {
      "name": "overspeed_basic",
      "description": "Basic overspeed event when device exceeds speed limit",
      "input": {
        "position": {
          "deviceId": 1,
          "time": "2023-01-01T12:00:00Z",
          "latitude": 40.7128,
          "longitude": -74.0060,
          "speed": 55.0,
          "attributes": {}
        },
        "device": {
          "id": 1,
          "name": "Test Device",
          "speedLimit": 40.0,
          "attributes": {}
        },
        "context": {
          "previousPositions": [
            {
              "deviceId": 1,
              "time": "2023-01-01T11:59:40Z",
              "latitude": 40.7125,
              "longitude": -74.0065,
              "speed": 50.0,
              "attributes": {}
            },
            {
              "deviceId": 1,
              "time": "2023-01-01T11:59:20Z",
              "latitude": 40.7122,
              "longitude": -74.0070,
              "speed": 50.0,
              "attributes": {}
            }
          ]
        }
      },
      "expected": {
        "events": [
          {
            "type": "deviceOverspeed",
            "deviceId": 1,
            "attributes": {
              "speed": 55.0,
              "speedLimit": 40.0
            }
          }
        ],
        "notifications": [
          {
            "type": "deviceOverspeed",
            "userId": 1,
            "deviceId": 1,
            "attributes": {
              "speed": 55.0,
              "speedLimit": 40.0,
              "deviceName": "Test Device"
            }
          }
        ]
      }
    },
    {
