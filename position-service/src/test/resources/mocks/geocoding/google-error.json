{
  "request": {
    "method": "GET",
    "urlPathPattern": "/maps/api/geocode/json.*",
    "queryParameters": {
      "latlng": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json",
      "Cache-Control": "no-cache"
    },
    "jsonBody": {
