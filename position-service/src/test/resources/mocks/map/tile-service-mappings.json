      "name": "OpenStreetMap Standard Tile",
      "request": {
        "method": "GET",
        "urlPathPattern": "/osm/standard/([0-9]+)/([0-9]+)/([0-9]+)\.png"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "image/png",
          "Cache-Control": "max-age=86400, must-revalidate",
          "Expires": "{{now offset='1 days' format='EEE, dd MMM yyyy HH:mm:ss z'}}",
          "Access-Control-Allow-Origin": "*"
        },
        "bodyFileName": "map/tiles/osm-standard-tile.png"
      }
    },
