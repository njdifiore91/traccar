    {
      "id": "protocol-service-basic-resolution",
      "name": "Protocol Service Basic Resolution",
      "description": "Basic scenario for resolving Protocol Service instances for position data reception",
      "service": "protocol-service",
      "communicationPattern": "async",
      "expectedInstances": [
        {
          "id": "protocol-service-1",
          "host": "protocol-service-1.traccar.svc.cluster.local",
          "port": 8080,
          "healthStatus": "UP",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1a",
            "protocols": ["tk103", "teltonika", "meitrack", "atrack"]
          }
        },
        {
          "id": "protocol-service-2",
          "host": "protocol-service-2.traccar.svc.cluster.local",
          "port": 8080,
          "healthStatus": "UP",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1b",
            "protocols": ["tk103", "teltonika", "meitrack", "atrack"]
          }
        },
        {
          "id": "protocol-service-3",
          "host": "protocol-service-3.traccar.svc.cluster.local",
          "port": 8080,
          "healthStatus": "UP",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1c",
            "protocols": ["tk103", "teltonika", "meitrack", "atrack"]
          }
        }
      ],
      "testParameters": {
        "messageType": "position",
        "deviceId": 123,
        "topicName": "raw-positions",
        "testDescription": "Verifies that Position Service can discover all available Protocol Service instances for receiving position data"
      }
