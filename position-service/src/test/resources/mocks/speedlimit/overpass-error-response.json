{
  "mappings": [
    {
      "name": "Overpass API Timeout Error",
      "request": {
        "urlPathPattern": "/api/interpreter.*",
        "method": "GET",
        "queryParameters": {
          "data": {
            "matches": ".*\\[out:json\\].*"
          }
        }
      },
      "response": {
        "status": 504,
        "headers": {
          "Content-Type": "application/json",
          "Access-Control-Allow-Origin": "*"
        },
        "jsonBody": {
          "version": 0.6,
          "generator": "Overpass API",
          "error": {
            "code": 504,
            "message": "Gateway Timeout",
            "details": "The server is probably too busy to handle your request. Please try again later or try a smaller query area."
          },
          "osm3s": {
            "timestamp_osm_base": "2025-05-24T00:00:00Z",
            "copyright": "The data included in this document is from www.openstreetmap.org. The data is made available under ODbL."
          }
        }
      }
    },
    {
