        "method": "POST",
        "path": "/api/events/subscribe",
        "headers": {
          "Content-Type": "application/json",
          "X-Correlation-ID": "corr-123456789"
        },
        "body": {
          "consumerId": "notification-service-01",
          "eventTypes": ["deviceMoving", "deviceStopped", "alarm"],
          "callbackUrl": "http://notification-service/api/notifications/process"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "X-Correlation-ID": "corr-123456789"
        },
