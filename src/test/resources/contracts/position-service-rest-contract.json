{
  "openapi": "3.0.3",
  "info": {
    "title": "Position Service REST API",
    "description": "REST API contract for the Position Service, defining endpoints for position data processing, storage, and retrieval",
    "version": "1.0.0",
    "contact": {
      "name": "Traccar Support",
      "url": "https://www.traccar.org/support/",
      "email": "support@traccar.org"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Position Service API base path"
    }
  ],
  "tags": [
    {
      "name": "positions",
      "description": "Position data operations"
    },
    {
      "name": "enrichment",
      "description": "Position enrichment operations"
    },
    {
      "name": "health",
      "description": "Service health and status operations"
    }
  ],
  "paths": {
    "/positions": {
      "post": {
        "tags": ["positions"],
        "summary": "Add a new position",
        "description": "Adds a new position to the system for processing and storage",
        "operationId": "addPosition",
        "requestBody": {
          "description": "Position object to be added",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PositionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Position successfully added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PositionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid position data supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "serviceAuth": []
          }
        ]
      },
      "get": {
        "tags": ["positions"],
        "summary": "Get positions",
        "description": "Retrieves positions based on specified filters",
        "operationId": "getPositions",
        "parameters": [
          {
            "name": "deviceId",
            "in": "query",
            "description": "Device ID to filter positions",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Start time for position retrieval (ISO-8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End time for position retrieval (ISO-8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of positions to return",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PositionResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/positions/{id}": {
      "get": {
        "tags": ["positions"],
        "summary": "Get position by ID",
        "description": "Retrieves a specific position by its ID",
        "operationId": "getPositionById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Position ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PositionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Position not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/positions/latest": {
      "get": {
        "tags": ["positions"],
        "summary": "Get latest positions",
        "description": "Retrieves the latest position for each specified device",
        "operationId": "getLatestPositions",
        "parameters": [
          {
            "name": "deviceIds",
            "in": "query",
            "description": "Comma-separated list of device IDs",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1,2,3"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PositionResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/positions/batch": {
      "post": {
        "tags": ["positions"],
        "summary": "Add multiple positions",
        "description": "Adds multiple positions to the system in a single batch operation",
        "operationId": "addPositionsBatch",
        "requestBody": {
          "description": "Array of position objects to be added",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PositionRequest"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Positions successfully added",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PositionResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid position data supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/positions/device/{deviceId}/count": {
      "get": {
        "tags": ["positions"],
        "summary": "Count positions for a device",
        "description": "Returns the count of positions for a specific device within a time range",
        "operationId": "countPositionsForDevice",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Device ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Start time for position count (ISO-8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End time for position count (ISO-8601 format)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "format": "int64",
                      "description": "Number of positions for the device"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/positions/enrichment/geocode": {
      "post": {
        "tags": ["enrichment"],
        "summary": "Geocode a position",
        "description": "Enriches a position with address information through reverse geocoding",
        "operationId": "geocodePosition",
        "requestBody": {
          "description": "Position coordinates to geocode",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeocodingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/positions/enrichment/speedlimit": {
      "post": {
        "tags": ["enrichment"],
        "summary": "Get speed limit for a position",
        "description": "Retrieves the speed limit for a specific location",
        "operationId": "getSpeedLimit",
        "requestBody": {
          "description": "Position coordinates to check for speed limit",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeedLimitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeedLimitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "serviceAuth": []
          }
        ]
      }
    },
    "/positions/enrichment/geofences": {
      "post": {
        "tags": ["enrichment"],
        "summary": "Check geofences for a position",
        "description": "Determines which geofences a position is located within",
        "operationId": "checkGeofences",
        "requestBody": {
          "description": "Position coordinates to check against geofences",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeofenceCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
