    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Get service health status",
        "description": "Returns the health status of the Position Service",
        "operationId": "getHealthStatus",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["health"],
        "summary": "Get service readiness status",
        "description": "Returns the readiness status of the Position Service",
        "operationId": "getReadinessStatus",
        "responses": {
          "200": {
            "description": "Service is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["health"],
        "summary": "Get service metrics",
        "description": "Returns metrics for the Position Service",
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PositionRequest": {
        "type": "object",
        "required": [
          "deviceId",
          "protocol",
          "time",
          "latitude",
          "longitude"
        ],
        "properties": {
          "deviceId": {
            "type": "integer",
            "format": "int64",
            "description": "Device identifier"
          },
          "protocol": {
            "type": "string",
            "description": "Protocol used to receive the position"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "Time when the position was recorded (ISO-8601 format)"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "Latitude coordinate"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "Longitude coordinate"
          },
          "altitude": {
            "type": "number",
            "format": "double",
            "description": "Altitude in meters"
          },
          "speed": {
            "type": "number",
            "format": "double",
            "description": "Speed in knots"
          },
          "course": {
            "type": "number",
            "format": "double",
            "description": "Course in degrees"
          },
          "accuracy": {
            "type": "number",
            "format": "double",
            "description": "Position accuracy in meters"
          },
          "valid": {
            "type": "boolean",
            "description": "Indicates if the position is valid"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            },
            "description": "Additional attributes for the position"
          }
        }
      },
      "PositionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Position identifier"
          },
          "deviceId": {
            "type": "integer",
            "format": "int64",
            "description": "Device identifier"
          },
          "protocol": {
            "type": "string",
            "description": "Protocol used to receive the position"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time",
            "description": "Time when the position was received by the server (ISO-8601 format)"
          },
          "deviceTime": {
            "type": "string",
            "format": "date-time",
            "description": "Time when the position was recorded by the device (ISO-8601 format)"
          },
          "fixTime": {
            "type": "string",
            "format": "date-time",
            "description": "Time when the position fix was acquired (ISO-8601 format)"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "Latitude coordinate"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "Longitude coordinate"
          },
          "altitude": {
            "type": "number",
            "format": "double",
            "description": "Altitude in meters"
          },
          "speed": {
            "type": "number",
            "format": "double",
            "description": "Speed in knots"
          },
          "course": {
            "type": "number",
            "format": "double",
            "description": "Course in degrees"
          },
          "accuracy": {
            "type": "number",
            "format": "double",
            "description": "Position accuracy in meters"
          },
          "valid": {
            "type": "boolean",
            "description": "Indicates if the position is valid"
          },
          "address": {
            "type": "string",
            "description": "Geocoded address for the position"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            },
            "description": "Additional attributes for the position"
          },
          "geofenceIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "IDs of geofences the position is located within"
          },
          "speedLimit": {
            "type": "number",
            "format": "double",
            "description": "Speed limit at the position location in knots"
          },
          "processed": {
            "type": "boolean",
            "description": "Indicates if the position has been fully processed"
          }
        }
      },
      "GeocodingRequest": {
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "Latitude coordinate"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "Longitude coordinate"
          }
        }
      },
      "GeocodingResponse": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "Geocoded address for the position"
          },
          "formattedAddress": {
            "type": "string",
            "description": "Formatted address string"
          },
          "country": {
            "type": "string",
            "description": "Country name"
          },
          "state": {
            "type": "string",
            "description": "State or province name"
          },
          "city": {
            "type": "string",
            "description": "City name"
          },
          "street": {
            "type": "string",
            "description": "Street name"
          },
          "houseNumber": {
            "type": "string",
            "description": "House number"
          },
          "postalCode": {
            "type": "string",
            "description": "Postal code"
          }
        }
      },
