  },
  "usage": {
    "description": "These command templates can be used in protocol encoder tests to verify command encoding functionality. Each protocol implementation can extend these templates with protocol-specific parameters.",
    "example": "To use in a test, create a Command object with the appropriate type and attributes, then pass it to the protocol encoder for encoding."
  },
  "extensibility": {
    "description": "Protocol-specific command parameters can be added to these base templates as needed. The 'custom' command type can be used for commands that don't fit any of the standard types.",
    "example": "For a protocol that requires additional parameters for the 'engineStop' command, extend the base template with those parameters before passing it to the encoder."
  },
  "testUsage": {
    "description": "Example of how to use these command templates in protocol encoder tests",
    "code": [
      "Command command = new Command();",
      "command.setType(Command.TYPE_ENGINE_STOP);",
      "command.set(Command.KEY_DEVICE_PASSWORD, '123456');",
      "verifyCommand(encoder, command, binary('01020304050607'));"
    ],
    "examples": {
      "positionSingle": {
        "description": "Request a single position update",
        "code": [
          "Command command = new Command();",
          "command.setType(Command.TYPE_POSITION_SINGLE);",
          "verifyCommand(encoder, command, binary('010203'));"
        ]
      },
      "engineStop": {
        "description": "Stop the vehicle engine",
        "code": [
          "Command command = new Command();",
          "command.setType(Command.TYPE_ENGINE_STOP);",
          "command.set(Command.KEY_DEVICE_PASSWORD, '123456');",
          "verifyCommand(encoder, command, binary('0102030405'));"
        ]
      },
      "outputControl": {
        "description": "Control digital output",
        "code": [
          "Command command = new Command();",
          "command.setType(Command.TYPE_OUTPUT_CONTROL);",
          "command.set(Command.KEY_INDEX, 1);",
          "command.set(Command.KEY_ENABLE, true);",
          "verifyCommand(encoder, command, binary('0102'));"
        ]
      }
    }
  }
}