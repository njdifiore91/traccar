      "supportedProtocols": ["teltonika", "meitrack", "atrack", "totem", "meiligao", "tk103"],
      "commonExtensions": {
        "devicePassword": "Device security password, required by some protocols",
        "data": "Protocol-specific format for frequency value"
      },
      "notes": "Frequency is specified in seconds. Some protocols may require specific frequency values or formats."
    },
