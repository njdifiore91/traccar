      },
      "supportedProtocols": ["teltonika", "meitrack", "atrack", "totem", "meiligao", "tk103"],
      "commonExtensions": {
        "devicePassword": "Device security password, required by some protocols",
        "uniqueId": "Device unique identifier",
        "protocol": "Specific protocol identifier for multi-protocol devices"
      },
      "notes": "The 'custom' command type is used for protocol-specific commands that don't fit any of the standard command types. The 'data' attribute contains the raw command data in the format expected by the device."
