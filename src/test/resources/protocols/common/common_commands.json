    "positionSingle": {
      "type": "positionSingle",
      "description": "Request a single position update from the device",
      "attributes": {},
      "supportedProtocols": ["teltonika", "meitrack", "atrack", "totem", "meiligao", "tk103"]
    },
    "positionPeriodic": {
      "type": "positionPeriodic",
      "description": "Configure periodic position reporting",
      "attributes": {
