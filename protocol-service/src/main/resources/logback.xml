<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback configuration for Protocol Service
    
    This configuration file defines structured JSON logging for the Protocol Service with:
    - Consistent field names across all services
    - MDC support for distributed tracing (traceId, spanId)
    - Appropriate log levels for application and third-party libraries
    - Log rotation to prevent disk space issues
    - Integration with centralized logging systems
-->
<configuration>
    <!-- Properties for logging configuration -->
    <property name="SERVICE_NAME" value="protocol-service" />
    <property name="LOG_PATH" value="logs" />
    <property name="LOG_ARCHIVE" value="${LOG_PATH}/archive" />
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [${SERVICE_NAME}] [%thread] [%X{traceId:-}] %-5level %logger{36} - %msg%n" />
    
    <!-- Environment-specific properties with defaults that can be overridden -->
    <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}" />
    <property name="LOG_MAX_FILE_SIZE" value="${LOG_MAX_FILE_SIZE:-100MB}" />
    <property name="LOG_MAX_HISTORY" value="${LOG_MAX_HISTORY:-30}" />
    <property name="LOG_TOTAL_SIZE_CAP" value="${LOG_TOTAL_SIZE_CAP:-3GB}" />
    
    <!-- Console Appender for local development and container logs -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Include MDC values for distributed tracing and context -->            
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>deviceId</includeMdcKeyName>
            <includeMdcKeyName>protocol</includeMdcKeyName>
            <includeMdcKeyName>connectionId</includeMdcKeyName>
            <includeMdcKeyName>remoteAddress</includeMdcKeyName>
            
            <!-- Add static fields to all log entries -->
            <customFields>{"service":"${SERVICE_NAME}","environment":"${ENV:-development}","version":"${VERSION:-dev}"}</customFields>
            
            <!-- Configure field names for consistency across services -->
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            
            <!-- Include exception details with stack traces -->
            <includeStackTrace>true</includeStackTrace>
            <stackTraceFieldName>exception</stackTraceFieldName>
        </encoder>
    </appender>
    
    <!-- File Appender with rotation policy for persistent logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${SERVICE_NAME}.log</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Include MDC values for distributed tracing and context -->            
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>deviceId</includeMdcKeyName>
            <includeMdcKeyName>protocol</includeMdcKeyName>
            <includeMdcKeyName>connectionId</includeMdcKeyName>
            <includeMdcKeyName>remoteAddress</includeMdcKeyName>
            
            <!-- Add static fields to all log entries -->
            <customFields>{"service":"${SERVICE_NAME}","environment":"${ENV:-development}","version":"${VERSION:-dev}","hostname":"${HOSTNAME:-unknown}"}</customFields>
            
            <!-- Configure field names for consistency across services -->
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            
            <!-- Include exception details with stack traces -->
            <includeStackTrace>true</includeStackTrace>
            <stackTraceFieldName>exception</stackTraceFieldName>
        </encoder>
        
        <!-- Configure log rotation to prevent disk space issues -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/${SERVICE_NAME}-%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>false</cleanHistoryOnStart>
        </rollingPolicy>
        
        <!-- Ensure logs are written even during high load -->        
        <immediateFlush>true</immediateFlush>
    </appender>
    
    <!-- Async appender for improved performance during high load -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE" />
        <queueSize>512</queueSize>
        <!-- Never discard logs, even under high load -->
        <discardingThreshold>0</discardingThreshold>
        <!-- Don't include caller data for better performance -->
        <includeCallerData>false</includeCallerData>
        <!-- Prevent logging from blocking application threads -->
        <neverBlock>true</neverBlock>
    </appender>
    
    <!-- Protocol-specific appender for detailed protocol logs -->
    <appender name="PROTOCOL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${SERVICE_NAME}-protocol.log</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>protocol</includeMdcKeyName>
            <includeMdcKeyName>deviceId</includeMdcKeyName>
            <includeMdcKeyName>connectionId</includeMdcKeyName>
            <includeMdcKeyName>remoteAddress</includeMdcKeyName>
            <customFields>{"service":"${SERVICE_NAME}","environment":"${ENV:-development}","log_type":"protocol"}</customFields>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ARCHIVE}/${SERVICE_NAME}-protocol-%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Async wrapper for protocol logs -->
    <appender name="ASYNC_PROTOCOL" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="PROTOCOL" />
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
    </appender>
    
    <!-- Set default log levels for third-party libraries (WARN to reduce noise) -->
    <logger name="org.apache" level="WARN" />
    <logger name="io.netty" level="WARN" />
    <logger name="com.zaxxer.hikari" level="WARN" />
    <logger name="org.hibernate" level="WARN" />
    <logger name="org.springframework" level="WARN" />
    <logger name="com.sun" level="WARN" />
    <logger name="javax.xml" level="WARN" />
    <logger name="com.fasterxml" level="WARN" />
    <logger name="io.grpc" level="WARN" />
    <logger name="io.kubernetes" level="WARN" />
    <logger name="com.google" level="WARN" />
    <logger name="org.eclipse.jetty" level="WARN" />
    
    <!-- Set specific log levels for Traccar components -->
    <logger name="org.traccar" level="${LOG_LEVEL}" />
    
    <!-- Protocol-specific logging configuration -->
    <logger name="org.traccar.protocol" level="${LOG_LEVEL}">
        <!-- Send protocol logs to dedicated appender -->
        <appender-ref ref="ASYNC_PROTOCOL" />
    </logger>
    
    <!-- Handler-specific logging configuration -->
    <logger name="org.traccar.handler" level="${LOG_LEVEL}" />
    
    <!-- Web-specific logging configuration -->
    <logger name="org.traccar.web" level="${LOG_LEVEL}" />
    
    <!-- Health check and metrics logging -->
    <logger name="org.traccar.health" level="${LOG_LEVEL}" />
    <logger name="org.traccar.metrics" level="${LOG_LEVEL}" />
    
    <!-- Discovery service logging -->
    <logger name="org.traccar.discovery" level="${LOG_LEVEL}" />
    
    <!-- Messaging system logging -->
    <logger name="org.traccar.messaging" level="${LOG_LEVEL}" />
    
    <!-- Root logger configuration -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ASYNC" />
    </root>
    
    <!-- Logback JMX MBean registration for runtime log level changes -->
    <jmxConfigurator />
    
    <!-- Shutdown hook to ensure logs are flushed on application shutdown -->
    <shutdownHook class="ch.qos.logback.core.hook.DelayingShutdownHook">
        <delay>1000</delay>
    </shutdownHook>
</configuration>