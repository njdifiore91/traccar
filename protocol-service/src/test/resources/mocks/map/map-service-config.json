{
  "mockServiceName": "map-service-mock",
  "description": "Mock configuration for map service interactions in protocol service tests",
  "version": "1.0.0",
  "baseUrl": "http://map-service.traccar.local",
  "endpoints": {
    "geocoding": {
      "path": "/geocode",
      "method": "GET",
      "queryParams": ["address"],
      "responseTemplate": {
        "status": "success",
        "results": [
          {
            "latitude": 37.4219999,
            "longitude": -122.0840575,
            "accuracy": 0.9,
            "formattedAddress": "1600 Amphitheatre Parkway, Mountain View, CA 94043, USA"
          }
        ]
      },
      "simulationParams": {
        "successRate": 0.95,
        "averageResponseTimeMs": 150,
        "errorResponse": {
          "status": "error",
          "message": "Geocoding service unavailable"
        }
      }
    },
    "reverseGeocoding": {
      "path": "/reverse",
      "method": "GET",
      "queryParams": ["lat", "lon"],
      "responseTemplate": {
        "status": "success",
        "address": {
          "road": "Amphitheatre Parkway",
          "houseNumber": "1600",
          "city": "Mountain View",
          "state": "California",
          "country": "United States",
          "postalCode": "94043",
          "formattedAddress": "1600 Amphitheatre Parkway, Mountain View, CA 94043, USA"
        }
      },
      "simulationParams": {
        "successRate": 0.95,
        "averageResponseTimeMs": 120,
        "errorResponse": {
          "status": "error",
          "message": "Reverse geocoding service unavailable"
        }
      },
      "predefinedResponses": [
        {
          "conditions": {
            "lat": 37.4219999,
            "lon": -122.0840575
          },
          "response": {
            "status": "success",
            "address": {
              "road": "Amphitheatre Parkway",
