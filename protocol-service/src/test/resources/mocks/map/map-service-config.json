    "routing": {
      "path": "/route",
      "method": "GET",
      "queryParams": ["startLat", "startLon", "endLat", "endLon"],
      "responseTemplate": {
        "status": "success",
        "distance": 10500,
        "duration": 1200,
        "polyline": "_p~iF~ps|U_ulLnnqC_mqNvxq`@",
        "instructions": [
          {
            "text": "Head north on Amphitheatre Parkway",
            "distance": 200,
            "duration": 30
          },
          {
            "text": "Turn right onto Charleston Road",
            "distance": 1500,
            "duration": 180
          },
          {
            "text": "Continue onto Rengstorff Avenue",
            "distance": 2800,
            "duration": 300
          }
        ]
      },
      "simulationParams": {
        "successRate": 0.9,
        "averageResponseTimeMs": 250,
        "errorResponse": {
          "status": "error",
          "message": "Routing service unavailable"
        }
      }
    },
    "speedLimits": {
      "path": "/speedlimit",
      "method": "GET",
      "queryParams": ["lat", "lon"],
      "responseTemplate": {
        "status": "success",
        "speedLimit": 65,
        "unit": "km/h",
        "roadType": "highway"
      },
      "simulationParams": {
        "successRate": 0.85,
        "averageResponseTimeMs": 100,
