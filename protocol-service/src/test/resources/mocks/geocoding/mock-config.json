    "mapbox": {
      "enabled": true,
      "endpoint": "http://localhost:8089/mapbox/geocoding/v5/mapbox.places",
      "apiKey": "mock-mapbox-api-key",
      "responseDelayMs": 140,
      "mockResponses": [
        {
          "latitude": 40.733,
          "longitude": -73.989,
          "address": "120 East 13th Street, New York, New York 10003, United States"
        }
      ]
    },
    "maptiler": {
      "enabled": true,
      "endpoint": "http://localhost:8089/maptiler/geocoding",
      "apiKey": "mock-maptiler-api-key",
      "responseDelayMs": 150,
      "mockResponses": [
        {
          "latitude": 40.733,
          "longitude": -73.989,
          "address": "East 13th Street, New York City, New York, United States"
        }
      ]
    },
    "geoapify": {
      "enabled": true,
      "endpoint": "http://localhost:8089/geoapify/v1/geocode/reverse",
      "apiKey": "mock-geoapify-api-key",
      "responseDelayMs": 180,
      "mockResponses": [
        {
          "latitude": 40.733,
          "longitude": -73.989,
          "address": "114 East 13th Street, New York, New York, US"
        }
      ]
    },
    "geocodejson": {
      "enabled": true,
      "endpoint": "http://localhost:8089/geocodejson/reverse",
      "responseDelayMs": 160,
      "mockResponses": [
        {
          "latitude": 40.7337807,
          "longitude": -73.9974401,
          "address": "35 West 9th Street, New York, New York, US"
        }
      ]
    }
  },
  "protocolSpecific": {
    "tk103": {
      "preferredProvider": "google",
      "fallbackProvider": "nominatim"
    },
    "meitrack": {
      "preferredProvider": "opencage",
      "fallbackProvider": "here"
    },
    "teltonika": {
      "preferredProvider": "here",
      "fallbackProvider": "google"
    },
    "atrack": {
      "preferredProvider": "nominatim",
      "fallbackProvider": "mapbox"
    },
    "totem": {
      "preferredProvider": "mapbox",
      "fallbackProvider": "maptiler"
    },
    "meiligao": {
      "preferredProvider": "maptiler",
      "fallbackProvider": "geoapify"
    }
  },
  "errorScenarios": {
    "connectionRefused": {
      "enabled": true,
      "probability": 0.01,
      "providers": ["google", "nominatim", "here"]
    },
    "timeout": {
      "enabled": true,
      "probability": 0.02,
      "timeoutMs": 5000,
      "providers": ["opencage", "geocodefarm", "mapbox"]
    },
    "rateLimited": {
      "enabled": true,
      "probability": 0.03,
      "providers": ["google", "here", "mapbox", "maptiler"]
    },
    "invalidResponse": {
      "enabled": true,
      "probability": 0.02,
      "providers": ["nominatim", "gisgraphy", "geocodexyz"]
    },
    "emptyResult": {
      "enabled": true,
      "probability": 0.05,
      "providers": ["all"]
    }
  },
  "cacheSimulation": {
    "enabled": true,
    "hitRatio": 0.7,
    "preloadedEntries": [
      {
        "latitude": 37.7749,
        "longitude": -122.4194,
        "address": "San Francisco, CA, USA"
      },
      {
        "latitude": 34.0522,
        "longitude": -118.2437,
        "address": "Los Angeles, CA, USA"
      },
      {
        "latitude": 51.5074,
        "longitude": -0.1278,
        "address": "London, UK"
      },
      {
        "latitude": 48.8566,
        "longitude": 2.3522,
        "address": "Paris, France"
      },
      {
        "latitude": 55.7558,
        "longitude": 37.6173,
        "address": "Moscow, Russia"
      }
    ]
  }
}