      "enabled": true,
      "endpoint": "http://localhost:8089/positionstack/v1/reverse",
      "apiKey": "mock-positionstack-api-key",
      "responseDelayMs": 170,
      "mockResponses": [
        {
          "latitude": 28.6129602407977,
          "longitude": 77.2294557094574,
          "address": "India Gate, New Delhi, India"
        }
      ]
