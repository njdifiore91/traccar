{
  "version": "1.0",
  "description": "Service resolution test scenarios for Protocol Service dependency discovery",
  "scenarios": [
    {
      "id": "position-service-normal",
      "name": "Position Service - Normal Resolution",
      "description": "Normal successful resolution of Position Service for position data publishing",
      "service": "position-service",
      "pattern": "synchronous",
      "instances": [
        {
          "id": "position-service-1",
          "host": "position-service.traccar.svc.cluster.local",
          "port": 8080,
          "protocol": "http",
          "health": "healthy",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1a",
            "priority": 10
          }
        }
      ],
      "expectedBehavior": "Connect to the single available instance",
      "tags": ["position", "basic", "synchronous"]
    },
    {
      "id": "position-service-multiple",
      "name": "Position Service - Multiple Instances",
      "description": "Resolution with multiple Position Service instances available",
      "service": "position-service",
      "pattern": "synchronous",
      "instances": [
        {
          "id": "position-service-1",
          "host": "position-service-1.traccar.svc.cluster.local",
          "port": 8080,
          "protocol": "http",
          "health": "healthy",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1a",
            "priority": 10
          }
        },
        {
          "id": "position-service-2",
          "host": "position-service-2.traccar.svc.cluster.local",
          "port": 8080,
          "protocol": "http",
          "health": "healthy",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1b",
            "priority": 20
          }
        },
        {
          "id": "position-service-3",
          "host": "position-service-3.traccar.svc.cluster.local",
          "port": 8080,
          "protocol": "http",
          "health": "healthy",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1c",
            "priority": 30
          }
        }
      ],
      "expectedBehavior": "Load balance between healthy instances with round-robin strategy",
      "tags": ["position", "load-balancing", "synchronous"]
    },
    {
      "id": "position-service-health-aware",
      "name": "Position Service - Health Aware Selection",
      "description": "Resolution with a mix of healthy and unhealthy Position Service instances",
      "service": "position-service",
      "pattern": "synchronous",
      "instances": [
        {
          "id": "position-service-1",
          "host": "position-service-1.traccar.svc.cluster.local",
          "port": 8080,
          "protocol": "http",
          "health": "unhealthy",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1a",
            "priority": 10
          }
        },
        {
          "id": "position-service-2",
          "host": "position-service-2.traccar.svc.cluster.local",
          "port": 8080,
          "protocol": "http",
          "health": "healthy",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1b",
            "priority": 20
          }
        },
        {
          "id": "position-service-3",
          "host": "position-service-3.traccar.svc.cluster.local",
          "port": 8080,
          "protocol": "http",
          "health": "degraded",
          "metadata": {
            "version": "1.0.0",
            "zone": "us-east-1c",
            "priority": 30
          }
        }
      ],
      "expectedBehavior": "Only route to healthy instances, with degraded instances used as fallback",
      "tags": ["position", "health-check", "synchronous"]
    },
