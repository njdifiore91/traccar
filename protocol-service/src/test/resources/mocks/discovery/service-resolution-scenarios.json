    {
      "id": "event-service-failover",
      "name": "Event Service - Failover Scenario",
      "description": "Failover scenario when primary Event Service instance becomes unhealthy",
      "service": "event-service",
      "pattern": "asynchronous",
      "sequence": [
        {
          "step": 1,
          "instances": [
            {
              "id": "event-service-1",
              "host": "event-service-1.traccar.svc.cluster.local",
              "port": 8081,
              "protocol": "http",
              "health": "healthy",
              "metadata": {
                "version": "1.0.0",
                "zone": "us-east-1a",
                "priority": 10
              }
            },
            {
              "id": "event-service-2",
              "host": "event-service-2.traccar.svc.cluster.local",
              "port": 8081,
              "protocol": "http",
              "health": "healthy",
              "metadata": {
                "version": "1.0.0",
                "zone": "us-east-1b",
                "priority": 20
              }
            }
          ],
          "expectedBehavior": "Connect to event-service-1 as primary instance"
        },
        {
          "step": 2,
          "instances": [
            {
              "id": "event-service-1",
              "host": "event-service-1.traccar.svc.cluster.local",
              "port": 8081,
              "protocol": "http",
              "health": "unhealthy",
              "metadata": {
                "version": "1.0.0",
                "zone": "us-east-1a",
                "priority": 10
              }
            },
            {
              "id": "event-service-2",
              "host": "event-service-2.traccar.svc.cluster.local",
              "port": 8081,
              "protocol": "http",
              "health": "healthy",
              "metadata": {
                "version": "1.0.0",
                "zone": "us-east-1b",
                "priority": 20
              }
            }
          ],
          "expectedBehavior": "Detect unhealthy primary and failover to event-service-2"
        },
        {
          "step": 3,
          "instances": [
            {
              "id": "event-service-1",
              "host": "event-service-1.traccar.svc.cluster.local",
              "port": 8081,
              "protocol": "http",
              "health": "healthy",
              "metadata": {
                "version": "1.0.0",
                "zone": "us-east-1a",
                "priority": 10
              }
            },
            {
              "id": "event-service-2",
              "host": "event-service-2.traccar.svc.cluster.local",
              "port": 8081,
              "protocol": "http",
              "health": "healthy",
              "metadata": {
                "version": "1.0.0",
                "zone": "us-east-1b",
                "priority": 20
              }
            }
          ],
          "expectedBehavior": "Detect recovered primary and fail back to event-service-1"
        }
      ],
      "tags": ["event", "failover", "asynchronous"]
    },
