{
  "description": "Position message template for RabbitMQ published by Protocol Service",
  "version": "1.0",
  "messageTypes": [
    {
      "name": "position",
      "description": "Standard GPS position message",
      "routingKey": "position.update",
      "exchange": "traccar.positions",
      "properties": {
        "contentType": "application/json",
        "contentEncoding": "UTF-8",
        "deliveryMode": 2,
        "priority": 0,
        "headers": {
          "protocol": "{{protocol}}",
          "deviceId": "{{deviceId}}",
          "timestamp": "{{timestamp}}"
        }
      },
      "payload": {
        "deviceId": "{{deviceId}}",
        "protocol": "{{protocol}}",
        "timestamp": "{{timestamp}}",
        "serverTime": "{{serverTime}}",
        "valid": true,
        "latitude": "{{latitude}}",
        "longitude": "{{longitude}}",
        "altitude": "{{altitude}}",
        "speed": "{{speed}}",
        "course": "{{course}}",
        "address": "{{address}}",
        "accuracy": "{{accuracy}}",
        "network": "{{network}}",
        "attributes": "{{attributes}}"
      }
    },
    {
      "name": "position.raw",
      "description": "Raw position data before processing",
      "routingKey": "position.raw",
      "exchange": "traccar.positions",
      "properties": {
        "contentType": "application/json",
        "contentEncoding": "UTF-8",
        "deliveryMode": 2,
        "priority": 0,
        "headers": {
          "protocol": "{{protocol}}",
          "deviceId": "{{deviceId}}",
          "timestamp": "{{timestamp}}"
        }
      },
      "payload": {
        "deviceId": "{{deviceId}}",
        "protocol": "{{protocol}}",
        "rawData": "{{rawData}}",
        "timestamp": "{{timestamp}}"
      }
    }
  ],
