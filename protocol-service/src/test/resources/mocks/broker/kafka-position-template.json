{
  "schemaVersion": "1.0",
  "description": "JSON template for position messages published to Kafka by the Protocol Service",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Position",
    "type": "object",
    "required": [
      "id",
      "deviceId",
      "protocol",
      "serverTime",
      "fixTime",
      "latitude",
      "longitude",
      "valid"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "description": "Unique position identifier"
      },
      "deviceId": {
        "type": "integer",
        "description": "Device identifier that generated this position"
      },
      "protocol": {
        "type": "string",
        "description": "Protocol used to receive the position data"
      },
      "serverTime": {
        "type": "string",
        "format": "date-time",
        "description": "Time when the server received the position"
      },
      "deviceTime": {
        "type": "string",
        "format": "date-time",
        "description": "Time reported by the device"
      },
      "fixTime": {
        "type": "string",
        "format": "date-time",
        "description": "GPS fix time"
      },
      "valid": {
        "type": "boolean",
        "description": "Indicates if the position is valid"
      },
      "latitude": {
        "type": "number",
        "description": "Latitude in degrees"
      },
      "longitude": {
        "type": "number",
        "description": "Longitude in degrees"
      },
      "altitude": {
        "type": "number",
        "description": "Altitude in meters",
        "default": 0
      },
      "speed": {
        "type": "number",
        "description": "Speed in knots",
        "default": 0
      },
      "course": {
        "type": "number",
        "description": "Direction in degrees",
        "default": 0
      },
      "accuracy": {
        "type": "number",
        "description": "Position accuracy in meters",
        "default": 0
      },
      "network": {
        "type": "object",
        "description": "Network information",
        "properties": {
          "radioType": {
            "type": "string",
            "description": "Radio type (GSM, CDMA, etc.)"
          },
          "cellTowers": {
            "type": "array",
            "description": "Cell tower information",
            "items": {
              "type": "object"
            }
          },
          "wifiAccessPoints": {
            "type": "array",
            "description": "WiFi access point information",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "attributes": {
        "type": "object",
        "description": "Additional attributes specific to the protocol or device",
        "additionalProperties": true
      }
    }
  },
