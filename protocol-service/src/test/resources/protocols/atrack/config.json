{
  "protocol": {
    "name": "atrack",
    "description": "Configuration for ATrack protocol tests"
  },
  "decoder": {
    "options": {
      "longDate": false,
      "custom": true,
      "decimalFuel": false
    },
    "formats": {
      "default": "%TS,%BV,%IO,%DA,%IP,%IG,%GS,%GQ,%CL,%CD,%CE,%LC,%TX",
      "extended": "%TS,%BV,%IO,%DA,%IP,%IG,%GS,%GQ,%CL,%CD,%CE,%LC,%TX,%OB,%J1,%J2",
      "obd": "%TS,%BV,%IO,%DA,%IP,%IG,%GS,%GQ,%CL,%CD,%CE,%LC,%TX,%OB"
    },
    "frameMasks": {
      "binary": "0x4050",
      "ascii": "0x4040"
    }
  },
  "test": {
    "cases": [
      {
        "name": "standardPosition",
        "description": "Test standard position report parsing",
        "options": {
          "longDate": false,
          "custom": false
        }
      },
      {
        "name": "longDatePosition",
        "description": "Test position report with long date format",
        "options": {
          "longDate": true,
          "custom": false
        }
      },
      {
        "name": "customFormatPosition",
        "description": "Test position report with custom format",
        "options": {
          "longDate": false,
          "custom": true,
          "format": "%TS,%BV,%IO,%DA,%IP,%IG,%GS,%GQ,%CL,%CD,%CE,%LC,%TX"
        }
      },
      {
        "name": "extendedFormatPosition",
        "description": "Test position report with extended format including OBD data",
        "options": {
          "longDate": false,
          "custom": true,
          "format": "%TS,%BV,%IO,%DA,%IP,%IG,%GS,%GQ,%CL,%CD,%CE,%LC,%TX,%OB,%J1,%J2"
        }
      },
      {
        "name": "binaryModePosition",
        "description": "Test binary mode position report parsing",
        "options": {
          "binary": true,
          "frameMask": "0x4050"
        }
      },
      {
        "name": "asciiModePosition",
        "description": "Test ASCII mode position report parsing",
        "options": {
          "binary": false,
          "frameMask": "0x4040"
        }
      },
      {
        "name": "decimalFuelPosition",
        "description": "Test position report with decimal fuel value format",
        "options": {
          "longDate": false,
          "custom": true,
          "decimalFuel": true
        }
      }
    ]
  }
}